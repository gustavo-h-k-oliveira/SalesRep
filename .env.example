# ==========================================
# Configurações do Banco de Dados PostgreSQL
# ==========================================

# Exemplo para Neon (PostgreSQL Serverless na Nuvem - Requer SSL):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-seu-projeto.us-east-1.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=seu_usuario_neon
# SPRING_DATASOURCE_PASSWORD=sua_senha_neon

# Exemplo para PostgreSQL local / Docker:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/salesrep_new
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# Hibernate DDL Auto (validate, update, none)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ==========================================
# Autenticação e Segurança (JWT & CORS)
# ==========================================
JWT_SECRET=sua_chave_secreta_jwt_super_segura_aqui_12345
JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
APP_SECURITY_CSRF_ENABLED=true
