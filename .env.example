# ==========================================
# Configurações do Banco de Dados PostgreSQL
# ==========================================
# Para conectar ao PostgreSQL rodando no Docker:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/salesrep_new
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# Hibernate DDL Auto (validate, update, none)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ==========================================
# Autenticação e Segurança (JWT & CORS)
# ==========================================
JWT_SECRET=sua_chave_secreta_jwt_super_segura_aqui_12345
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_SECURITY_CSRF_ENABLED=true
